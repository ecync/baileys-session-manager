{
  "name": "@ecync/baileys-session-manager",
  "version": "1.0.2",
  "description": "A drop-in replacement for Baileys' useMultiFileAuthState, backed by MongoDB, PostgreSQL, MySQL, SQLite, Cloudflare D1, Firebase, or Firestore, with optional Redis caching (TCP or HTTP), AES-256 encryption at rest, and distributed locking.",
  "keywords": [
    "baileys",
    "whatsapp",
    "whatsapp-web",
    "session-manager",
    "auth-state",
    "multi-file-auth-state",
    "redis",
    "mongodb",
    "postgres",
    "mysql",
    "sqlite",
    "cloudflare-d1",
    "firebase",
    "firestore",
    "encryption"
  ],
  "license": "MIT",
  "author": "Eshan Chathuranga",
  "homepage": "https://github.com/ecync/baileys-session-manager#readme",
  "bugs": {
    "url": "https://github.com/ecync/baileys-session-manager/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecync/baileys-session-manager.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src test --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"examples/**/*.ts\" \"*.md\"",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "async-mutex": "^0.5.0",
    "p-limit": "^6.2.0",
    "p-queue": "^8.0.1"
  },
  "peerDependencies": {
    "@upstash/redis": "^1.34.0",
    "baileys": ">=6.6.0",
    "better-sqlite3": "^11.0.0",
    "firebase-admin": "^12.0.0",
    "ioredis": "^5.4.0",
    "mongodb": "^6.0.0",
    "mysql2": "^3.11.0",
    "pg": "^8.12.0"
  },
  "peerDependenciesMeta": {
    "@upstash/redis": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "firebase-admin": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@upstash/redis": "^1.34.0",
    "better-sqlite3": "^11.0.0",
    "firebase-admin": "^12.0.0",
    "ioredis": "^5.4.0",
    "ioredis-mock": "^8.9.0",
    "mongodb": "^6.0.0",
    "mysql2": "^3.11.0",
    "pg": "^8.12.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.27.7": true,
    "esbuild@0.21.5": true,
    "protobufjs@7.6.6": true
  }
}
